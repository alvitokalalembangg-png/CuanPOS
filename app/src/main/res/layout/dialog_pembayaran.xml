<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#F5EFF5"
    app:strokeWidth="0dp"
    style="@style/Widget.Material3.CardView.Filled">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfirmasi Pembayaran"
            android:fontFamily="@font/open_sauce_medium"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Tagihan"
            android:fontFamily="@font/open_sauce_medium"
            android:textColor="#7A7A7A"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvDialogTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:fontFamily="@font/open_sauce_medium"
            android:textColor="#0039ff"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uang Diterima (Rp)"
            android:fontFamily="@font/open_sauce_medium"
            android:textColor="#7A7A7A"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <!-- Kolom Putih Bersih menggunakan background bawaan yang di-tint putih -->
        <EditText
            android:id="@+id/etUangDiterima"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#FFFFFF"
            android:fontFamily="@font/open_sauce_medium"
            android:hint="Contoh: 50000"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uang Kembalian"
            android:fontFamily="@font/open_sauce_medium"
            android:textColor="#7A7A7A"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvDialogKembalian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:fontFamily="@font/open_sauce_medium"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogBatal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="BATAL"
                android:fontFamily="@font/open_sauce_medium"
                android:textColor="#7A7A7A"
                app:strokeColor="#7A7A7A"
                app:cornerRadius="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogSelesai"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.4"
                android:layout_marginStart="6dp"
                android:text="SELESAI"
                android:fontFamily="@font/open_sauce_medium"
                android:backgroundTint="#0039ff"
                android:textColor="#FFFFFF"
                app:cornerRadius="24dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>