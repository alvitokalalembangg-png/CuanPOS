<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#F5EFF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Judul Dialog -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Konfirmasi Log Out"
            android:textColor="#000000"
            android:textSize="22sp"
            android:fontFamily="@font/open_sauce_medium"
            android:textStyle="bold" />

        <!-- Isi Pesan Khusus Admin -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:text="Apakah Anda yakin ingin keluar dari akun admin?"
            android:textColor="#555555"
            android:textSize="15sp"
            android:fontFamily="@font/open_sauce_regular"
            android:lineSpacingMultiplier="1.2" />

        <!-- Area Tombol Aksi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatalLogoutAdmin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="BATAL"
                android:textColor="#757575"
                app:strokeColor="#0039ff"
                app:cornerRadius="24dp"
                android:fontFamily="@font/open_sauce_medium"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnYaLogoutAdmin"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="KELUAR"
                android:textColor="#F5EFF5"
                app:backgroundTint="#0039ff"
                app:cornerRadius="24dp"
                android:fontFamily="@font/open_sauce_medium"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>