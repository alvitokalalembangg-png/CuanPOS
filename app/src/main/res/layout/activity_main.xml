<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Judul Aplikasi -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CuanPOS Login"
        android:textSize="28sp"
        android:textColor="@android:color/black"
        android:fontFamily="@font/open_sauce_medium"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pilihan Tab (Sekarang sudah pakai font Open Sauce via tabTextAppearance) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:tabIndicatorColor="#0039ff"
        app:tabSelectedTextColor="#0039ff"
        app:tabTextAppearance="@style/TabFontKonsep"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kasir (PIN)" />
    </com.google.android.material.tabs.TabLayout>

    <!-- CONTAINER FORM INPUT -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Input Email Admin -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email Admin"
            app:hintTextColor="#0039ff"
            app:boxStrokeColor="#0039ff">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sauce_regular"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Input Password Admin -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Password Admin"
            app:hintTextColor="#0039ff"
            app:boxStrokeColor="#0039ff"
            app:endIconMode="password_toggle"
            app:endIconTint="#0039ff">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sauce_regular"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Input PIN Kasir (Awalnya Tersembunyi / GONE) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PIN Kasir (4 Angka)"
            android:visibility="gone"
            app:hintTextColor="#0039ff"
            app:boxStrokeColor="#0039ff"
            app:endIconMode="password_toggle"
            app:endIconTint="#0039ff">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="4"
                android:fontFamily="@font/open_sauce_regular"
                android:inputType="numberPassword" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Tombol Masuk (Lebar match_parent mengikuti kolom, tinggi tetap ramping 48dp) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="MASUK"
        android:textSize="14sp"
        android:fontFamily="@font/open_sauce_medium"
        app:backgroundTint="#0039ff"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/formContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>