<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FDF8FD"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="#0039ff"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Baris Atas: ID Transaksi & Total -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvIdTransaksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="#TRX-20260719"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/open_sauce_regular" />

            <TextView
                android:id="@+id/tvTotalVoid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Rp 45.000"
                android:textColor="#0039ff"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/open_sauce_regular" />
        </RelativeLayout>

        <!-- Alasan Void -->
        <TextView
            android:id="@+id/tvAlasanVoid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Alasan: Salah input jumlah porsi oleh kasir."
            android:textColor="#7A7A7A"
            android:textSize="13sp"
            android:fontFamily="@font/open_sauce_regular" />

        <!-- Tombol Aksi (Tolak & Setujui) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTolakVoid"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="TOLAK"
                android:textColor="#FF3B30"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="#FF3B30"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetujuiVoid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="SETUJUI"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#0039ff"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>