<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/apk/res-auto"
    package="com.example.cuanpos">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CuanPOS"
        tools:targetApi="31">

        <!-- 1. Halaman Utama / Login -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Halaman Dashboard Admin -->
        <activity
            android:name=".AdminActivity"
            android:exported="false" />

        <!-- 3. Halaman Kelola Produk -->
        <activity
            android:name=".KelolaProdukActivity"
            android:exported="false" />

        <!-- 4. Halaman Kelola Kategori -->
        <activity
            android:name=".KelolaKategoriActivity"
            android:exported="false" />

        <!-- 5. Halaman Kasir -->
        <activity
            android:name=".KasirActivity"
            android:exported="false" />

        <activity
            android:name=".LaporanPenjualanActivity"
            android:exported="false" />

        <activity
            android:name=".ApprovalVoidActivity"
            android:exported="false" />

    </application>

</manifest>